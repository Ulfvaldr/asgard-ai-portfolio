@@ -0,0 +1,13 @@
+from label_tools import normalize_label
+
+
+def test_normalize_label_trims_collapses_and_lowercases():
+    assert normalize_label("  New   Product\tLabel  ") == "new product label"
+
+
+def test_normalize_label_preserves_single_word_lowercase():
+    assert normalize_label("Widget") == "widget"
+
+
+def test_normalize_label_returns_empty_string_for_blank_input():
+    assert normalize_label(" \n\t ") == ""
