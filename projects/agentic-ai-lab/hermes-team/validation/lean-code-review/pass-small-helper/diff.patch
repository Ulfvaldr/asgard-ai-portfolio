@@ -0,0 +1,7 @@
+import re
+
+
+def normalize_label(value: str) -> str:
+    """Return a stable lowercase label with normalized whitespace."""
+    collapsed = re.sub(r"\s+", " ", value.strip())
+    return collapsed.lower()
diff --git a/test_label_tools.py b/test_label_tools.py
new file mode 100644
