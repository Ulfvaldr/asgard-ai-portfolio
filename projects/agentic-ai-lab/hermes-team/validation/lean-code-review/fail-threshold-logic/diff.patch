@@ -0,0 +1,5 @@
+def qualifies_for_free_shipping(total_cents: int, threshold_cents: int = 5000) -> bool:
+    """Return whether an order total is at least the free-shipping threshold."""
+    if total_cents > threshold_cents:
+        return True
+    return False
