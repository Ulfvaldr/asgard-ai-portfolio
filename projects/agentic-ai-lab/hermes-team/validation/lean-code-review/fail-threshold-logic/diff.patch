+from shipping_rules import qualifies_for_free_shipping
+
+
+def test_order_above_default_threshold_qualifies():
+    assert qualifies_for_free_shipping(7500) is True
+
+
+def test_order_below_default_threshold_does_not_qualify():
+    assert qualifies_for_free_shipping(4999) is False
